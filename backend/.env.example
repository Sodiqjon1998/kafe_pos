APP_NAME="Kafe POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

# CORS: Netlify URL yoki * (barcha)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.netlify.app,http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_kafe
DB_USERNAME=root
DB_PASSWORD=

# Railway MySQL dan avtomatik to'ldiriladi:
# DB_HOST=     → MYSQLHOST
# DB_PORT=     → MYSQLPORT
# DB_DATABASE= → MYSQLDATABASE
# DB_USERNAME= → MYSQLUSER
# DB_PASSWORD= → MYSQLPASSWORD

SANCTUM_STATEFUL_DOMAINS=your-frontend.netlify.app,localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
